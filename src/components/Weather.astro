---
import { getWeather, weatherCodeText, weatherCodeIcon, formatTimeHM, formatDayLabel } from '../utils/weather';

// 服务端渲染：页面每个请求时在服务器获取（带 30 分钟缓存），不向客户端暴露任何代码
const weather = await getWeather();
const current = weather?.current;
const daily = weather?.daily;
---

{weather && current && daily && (
  <section id="موسم" class="border-y border-green-900/10 bg-[#eef3e9] py-16 md:py-24">
    <div class="shell">
      <p class="eyebrow">موسم</p>
      <h2 class="section-title mt-2">موجودہ موسم اور 5 روزہ پیشن گوئی</h2>
      <div class="mt-8 grid gap-6 lg:grid-cols-[.9fr_1.1fr]">
        <article class="card p-7 md:p-8">
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="text-sm font-bold text-green-800">ابھی کا موسم</p>
              <p class="mt-3 text-6xl font-black leading-none text-green-950" dir="ltr">{Math.round(current.temperature_2m)}°C</p>
              <p class="mt-3 text-lg font-black text-green-900">{weatherCodeIcon(current.weather_code)} {weatherCodeText(current.weather_code)}</p>
            </div>
            <div class="rounded-2xl bg-green-950 px-4 py-3 text-center text-sm text-white">
              <p class="text-xs text-green-200">آج کی حد</p>
              <p class="mt-1 font-black" dir="ltr">{Math.round(daily.temperature_2m_max[0] ?? 0)}° / {Math.round(daily.temperature_2m_min[0] ?? 0)}°</p>
            </div>
          </div>
          <dl class="mt-7 grid grid-cols-2 gap-3 sm:grid-cols-4">
            <div class="rounded-2xl bg-green-50 p-4"><dt class="text-xs font-bold text-green-800">محسوس درجہ حرارت</dt><dd class="mt-1 font-black text-green-950" dir="ltr">{Math.round(current.apparent_temperature)}°C</dd></div>
            <div class="rounded-2xl bg-green-50 p-4"><dt class="text-xs font-bold text-green-800">نمی</dt><dd class="mt-1 font-black text-green-950" dir="ltr">{Math.round(current.relative_humidity_2m)}%</dd></div>
            <div class="rounded-2xl bg-green-50 p-4"><dt class="text-xs font-bold text-green-800">ہوا</dt><dd class="mt-1 font-black text-green-950" dir="ltr">{Math.round(current.wind_speed_10m)} کلومیٹر/گھنٹہ</dd></div>
            <div class="rounded-2xl bg-green-50 p-4"><dt class="text-xs font-bold text-green-800">بارش</dt><dd class="mt-1 font-black text-green-950" dir="ltr">{current.precipitation > 0 ? `${current.precipitation} ملی میٹر` : 'نہیں'}</dd></div>
          </dl>
          <p class="mt-5 text-sm leading-7 text-slate-600">طلوع آفتاب: <strong>{formatTimeHM(daily.sunrise[0] ?? '')}</strong> • غروب آفتاب: <strong>{formatTimeHM(daily.sunset[0] ?? '')}</strong></p>
        </article>
        <div class="grid gap-3 sm:grid-cols-2">
          {daily.time.map((t, i) => (
            <article class="card p-5">
              <p class="text-sm font-black text-green-950">{formatDayLabel(t)}</p>
              <p class="mt-2 font-bold text-green-900">{weatherCodeIcon(daily.weather_code[i] ?? 0)} {weatherCodeText(daily.weather_code[i] ?? 0)}</p>
              <p class="mt-2 font-black text-green-950" dir="ltr">{Math.round(daily.temperature_2m_max[i] ?? 0)}° / {Math.round(daily.temperature_2m_min[i] ?? 0)}°</p>
              <p class="mt-1 text-xs text-slate-500">بارش کا امکان: {daily.precipitation_probability_max[i] ?? 0}%</p>
            </article>
          ))}
        </div>
      </div>
      <p class="mt-5 text-xs leading-6 text-slate-500">موسم کا ڈیٹا Open-Meteo کے مفت عوامی API سے حاصل کیا جاتا ہے اور تقریباً 30 منٹ تک کیش کیا جاتا ہے۔ سفر سے پہلے ہمیشہ مقامی ذرائع سے تازہ معلومات کی تصدیق کریں۔</p>
    </div>
  </section>
)}
