---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Cookie ترتیبات — جناح پارک گائیڈ" description="Google Analytics کی موجودہ اجازت دیکھیں، محفوظ کریں یا فوراً واپس لیں؛ باقی خدمات الگ ہیں۔" path="/cookies/">
<main class="shell py-16"><a class="btn btn-soft" href="/">مرکزی گائیڈ</a><article class="card prose-urdu mt-6 p-8"><h1 class="section-title">Cookie ترتیبات</h1><p class="mt-5">یہ اختیار صرف Google Analytics کو کنٹرول کرتا ہے۔ نقشہ، موسم اور ہوسٹنگ الگ خدمات ہیں۔ کوئی الگ ترجیح یا مارکیٹنگ فنکشن نافذ نہیں، اس لیے اس کا غیر فعال اختیار دکھایا نہیں جاتا۔</p><p class="mt-4">انتخاب localStorage میں محفوظ ہوتا ہے؛ سائٹ کا الگ ضروری Cookie نہیں۔ رضامندی پڑھی اور محفوظ ہونے کی تصدیق کے بعد GA4 شروع ہوتا ہے۔ اجازت واپس لینے سے پہلے بھیجا گیا ڈیٹا حذف نہیں ہوتا۔</p>
<form id="cookie-form" class="mt-8"><label class="flex items-center gap-4"><input type="checkbox" id="analytics" class="h-5 w-5"/><span>Google Analytics کی اجازت</span></label><div class="mt-6 flex flex-wrap gap-4"><button class="btn btn-primary" type="submit">انتخاب محفوظ کریں</button><button class="btn btn-soft" id="reject" type="button">تجزیہ بند کریں</button></div><p class="mt-5" id="status" role="status" aria-live="polite"></p></form><a class="mt-6 inline-block underline" href="/privacy/">رازداری کی مکمل وضاحت</a></article></main>
<script is:inline>
(()=>{const form=document.getElementById('cookie-form'),input=document.getElementById('analytics'),status=document.getElementById('status'),api=window.jinnahAnalytics;
input.checked=api?.get()===true;
function save(allow){const result=api?.set(allow);input.checked=result?.effective===true;status.textContent=result?.saved?(allow?'رضامندی محفوظ اور تجزیہ فعال ہے۔':'تجزیہ بند اور انتخاب محفوظ ہے۔'):'انتخاب محفوظ ہونے کی تصدیق نہیں ہوئی۔ اس صفحے میں تجزیہ بند ہے؛ دوسرے ٹیب یا پرانا محفوظ انتخاب مختلف ہو سکتا ہے۔';}
form.addEventListener('submit',event=>{event.preventDefault();save(input.checked)});document.getElementById('reject').addEventListener('click',()=>save(false));window.addEventListener('storage',event=>{if(event.key==='jp-cookie-consent'||event.key===null)input.checked=api?.get()===true});})();
</script>
</BaseLayout>
