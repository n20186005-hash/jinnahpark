---
import BaseLayout from '../layouts/BaseLayout.astro';
import Weather from '../components/Weather.astro';

const pageTitle = 'Jinnah Park Rawalpindi (جناح پارک) — Timings, Cinepax & Visitor Guide';
const pageDescription = 'Jinnah Park (جناح پارک), Rawalpindi — visitor guide with timings, Cinepax cinema, restaurants, location map, parking, weather and FAQs. Plan your visit to جناح پارک راولپنڈی، پنجاب، پاکستان۔';
const canonical = Astro.site ? new URL('/', Astro.site).toString() : undefined;
const image = Astro.site ? new URL('/images/jinnah-park-hero.jpg', Astro.site).toString() : '/images/jinnah-park-hero.jpg';
const siteOrigin = Astro.site ? Astro.site.origin : 'https://jinnahpark.com';

const attractionSchema = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'Park'],
  '@id': `${siteOrigin}/#attraction`,
  name: 'Jinnah Park',
  alternateName: ['جناح پارک', 'Jinnah Park Rawalpindi', 'Jinnah Park Chaklala'],
  description: pageDescription,
  ...(canonical ? { url: canonical } : {}),
  image: [image],
  isAccessibleForFree: true,
  hasMap: 'https://maps.app.goo.gl/dXD85cQCFkmbErrWA',
  telephone: '+92 315 9734114',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Mushtaq Baig Shaheed Road, Chaklala Cantt.',
    addressLocality: 'Rawalpindi',
    postalCode: '46000',
    addressRegion: 'Punjab',
    addressCountry: 'PK'
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 33.57992867333843,
    longitude: 73.06731487734208
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.5',
    reviewCount: '28750',
    bestRating: '5'
  },
  openingHoursSpecification: [{
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'],
    opens: '06:00',
    closes: '23:59'
  }],
  sameAs: [
    'https://maps.app.goo.gl/dXD85cQCFkmbErrWA',
    'https://tourism.punjab.gov.pk/',
    'https://tourism.gov.pk/',
    'https://www.wikidata.org/wiki/Q6202662',
    'https://commons.wikimedia.org/wiki/Category:Jinnah_Park,_Rawalpindi',
    'https://en.wikipedia.org/wiki/Jinnah_Park_(Rawalpindi)'
  ]
};

const faq = [
  ['جناح پارک کہاں واقع ہے؟','یہ Mushtaq Baig Shaheed Road، Chaklala Cantt.، Rawalpindi 46000 میں واقع ہے۔ Google Maps پر Jinnah Park Rawalpindi تلاش کرنا سب سے آسان طریقہ ہے۔'],
  ['پارک کے عام اوقات کیا ہیں؟','متعدد تازہ عوامی لسٹنگز پارک کے عمومی اوقات صبح 6 بجے سے رات 12 بجے تک بتاتی ہیں۔ خصوصی سہولیات، سینما اور ریستوران کے اوقات مختلف ہو سکتے ہیں، اس لیے روانگی سے پہلے تازہ معلومات چیک کریں۔'],
  ['داخلہ اور دوسری سرگرمیوں کی فیس کتنی ہے؟','پارک، پارکنگ، سینما، بولنگ، رائیڈز اور دوسری سرگرمیوں کی فیس ایک جیسی نہیں ہوتی اور وقت کے ساتھ بدل سکتی ہے۔ اہم اخراجات کے لیے مقام یا متعلقہ آپریٹر سے تازہ تصدیق بہتر ہے۔'],
  ['کتنا وقت رکھنا مناسب ہے؟','صرف باغیچے اور واک کے لیے تقریباً 1 سے 2 گھنٹے مناسب ہیں؛ کھانے، سینما یا تفریحی سرگرمی شامل ہو تو 3 گھنٹے یا اس سے زیادہ رکھیں۔'],
  ['کیا خاندان اور بچوں کے لیے مناسب ہے؟','جناح پارک اپنے سبز میدانوں، واکنگ ایریاز اور تفریحی سہولیات کی وجہ سے خاندانوں کے لیے مقبول مقام ہے۔ بچوں کے ساتھ جاتے وقت مصروف اوقات میں اضافی نگرانی مفید رہتی ہے۔'],
  ['کیا پارک میں بیت الخلا (WC) کی سہولت ہے؟','جی ہاں، پارک کے اندر متعدد مقامات پر عوامی بیت الخلا موجود ہیں۔ خاندانوں اور بچوں کے ساتھ جانے والوں کے لیے ان کی صفائی پر خصوصی توجہ دی جاتی ہے۔'],
  ['کیا پارک کے قریب ہوٹل یا رہائش دستیاب ہے؟','پارک کے ارد گرد مختلف معیار کے ہوٹل اور گیسٹ ہاؤس موجود ہیں۔ ہم کسی مخصوص ادارے کی سفارش نہیں کرتے؛ نقشے پر تازہ جائزے اور قیمتیں دیکھ کر اپنی ضرورت کے مطابق انتخاب کریں۔'],
  ['کیا پارک کے قریب پیٹرول پمپ ہیں؟','جی ہاں، پارک کے آس پاس کی مرکزی سڑکوں پر پیٹرول پمپ دستیاب ہیں۔ اگر آپ الیکٹرک گاڑی استعمال کر رہے ہیں تو چارجنگ پوائنٹس کی دستیابی سفر سے پہلے نقشے پر چیک کر لیں۔'],
  ['کیا "Jinah Park"، "Jannah Park" یا "Jina Park" دراصل جناح پارک ہی ہے؟','جی ہاں، بہت سے لوگ تلفظ یا املا کی وجہ سے اسے Jinah Park، Jannah Park یا Jina Park لکھ دیتے ہیں، لیکن مراد راولپنڈی کا جناح پارک ہی ہے۔ صحیح املا Jinnah Park ہے۔'],
  ['جناح پارک میں Cinepax (سینما) کا نمبر کیا ہے؟','کمپلیکس میں Cinepax نامی ملٹی پلیکس سینما موجود ہے۔ ٹکٹ اور شوز کی تازہ معلومات کے لیے پارک کا رابطہ نمبر یا Cinepax کی آفیشل سائٹ دیکھیں؛ سینما کے اوقات پارک کے عمومی اوقات سے مختلف ہو سکتے ہیں۔'],
  ['جناح پارک میں کھانے اور فاسٹ فوڈ کیا ملتا ہے؟','پارک کے اندر اور اطراف فاسٹ فوڈ، خاندانی ریستوران، کافی شاپس اور آئس کریم کی دکانیں موجود ہیں۔ برانچوں کے اوقات روانگی سے پہلے تصدیق کر لیں۔']
];
const faqSchema = {
  '@context':'https://schema.org',
  '@type':'FAQPage',
  mainEntity: faq.map(([q,a]) => ({ '@type':'Question', name:q, acceptedAnswer:{ '@type':'Answer', text:a } }))
};

// English FAQ（与乌尔都语 FAQ 并存，针对英文搜索 / AI 概览卡片）
const englishFaq = [
  ['Where is Jinnah Park located?','Jinnah Park is located on Mushtaq Baig Shaheed Road, Chaklala Cantt., Rawalpindi, 46000, Pakistan. Searching “Jinnah Park Rawalpindi” on Google Maps is the easiest way to find it.'],
  ['What are the opening hours of Jinnah Park?','Public listings indicate general hours from 06:00 to 23:59 daily. Hours for special facilities, the cinema, and restaurants may vary, so verify before you go.'],
  ['Is Jinnah Park free to visit?','Yes, Jinnah Park is a public space and is free to enter year-round. Some on-site operators (cinema, bowling, rides, parking) may charge separately.'],
  ['How do I get to Jinnah Park from Islamabad?','From Islamabad, take IJP Road and the Expressway; the park is about 30–35 km from Islamabad International Airport (ISB), roughly a 40–50 minute drive. Ride-hailing apps and taxis are also available.'],
  ['What is there to do near Jinnah Park?','Nearby attractions include Ayub National Park and the Pakistan Army Museum, both in Rawalpindi and easy to combine in a single day trip.'],
  ['Is Jinnah Park family friendly?','Yes, with green lawns, walking areas, and recreational facilities, Jinnah Park is popular with families. Extra supervision during busy hours is recommended with children.'],
  ['Looking for Jinah Park, Jannah Park or Jina Park in Rawalpindi?','Those are common misspellings — they all refer to Jinnah Park, the public park on Mushtaq Baig Shaheed Road, Chaklala Cantt., Rawalpindi.'],
  ['What is the Cinepax / cinema number at Jinnah Park?','Jinnah Park has an on-site Cinepax multiplex cinema. For showtimes and tickets, check the Cinepax listing or call the park’s contact line; cinema hours may differ from the park’s general hours.'],
  ['What restaurants and fast food are at Jinnah Park?','The complex includes fast-food outlets, family restaurants, coffee shops and ice-cream stalls. Hours for food outlets can differ from the park’s general opening hours.']
];
const englishFaqSchema = {
  '@context':'https://schema.org',
  '@type':'FAQPage',
  mainEntity: englishFaq.map(([q,a]) => ({ '@type':'Question', name:q, acceptedAnswer:{ '@type':'Answer', text:a } }))
};
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteOrigin}/#website`,
  url: `${siteOrigin}/`,
  name: 'Jinnah Park Rawalpindi Visitor Guide',
  alternateName: 'جناح پارک راولپنڈی وزیٹر گائیڈ',
  description: pageDescription,
  inLanguage: 'ur-PK',
  publisher: {
    '@type': 'Organization',
    '@id': `${siteOrigin}/#organization`,
    name: 'Jinnah Park Rawalpindi Visitor Guide (غیر منافع بخش)',
    url: `${siteOrigin}/`
  }
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Pakistan', item: `${siteOrigin}/` },
    { '@type': 'ListItem', position: 2, name: 'Punjab', item: `${siteOrigin}/` },
    { '@type': 'ListItem', position: 3, name: 'Rawalpindi', item: `${siteOrigin}/` },
    { '@type': 'ListItem', position: 4, name: 'Jinnah Park', item: `${siteOrigin}/` }
  ]
};

const timeline = [
  ['1882','مرکزی جیل کا قیام','آج کے پارک کی جگہ پر راولپنڈی کی مرکزی جیل قائم ہوئی، جو اپنے وقت میں ملک کی اہم جیلوں میں شمار ہوتی تھی۔'],
  ['1979','جیل کی تاریخ کا ایک باب','اس جیل میں پاکستان کے سابق وزیرِ اعظم ذوالفقار علی بھٹو کو 1979ء میں پھانسی دی گئی۔ یہ واقعہ ملکی تاریخ کا ایک تلخ باب ہے۔'],
  ['1986–1988','جیل کی منتقلی اور انہدام','ایڈیالہ جیل کی تعمیر کے بعد قیدیوں کو منتقل کیا گیا اور 1988ء میں پرانی جیل کو منہدم کر دیا گیا۔'],
  ['1995','پارک کے منصوبے کا آغاز','راولپنڈی ڈیولپمنٹ اتھارٹی (RDA) نے اس تاریخی مقام کو عوامی پارک بنانے کا منصوبہ شروع کیا اور تعمیر کا کام اسلام آباد کی کیپٹل ڈیولپمنٹ اتھارٹی (CDA) کو سونپا۔'],
  ['2004','منصوبے کی منتقلی','کئی سال تک نامکمل رہنے والا یہ منصوبہ پاک فوج کے دسویں کور کے حوالے کیا گیا تاکہ تعمیر مکمل ہو سکے۔'],
  ['2006','جناح پارک کا افتتاح','پارک عوام کے لیے کھول دیا گیا۔ اس منصوبے پر تقریباً 329 ملین روپے لاگت آئی۔']
];

const stories = [
  ['ماضی سے روشن مستقبل تک','جہاں کبھی ایک اعلیٰ حفاظتی جیل قیدیوں کو رکھنے کا مقام تھی، آج وہیں لاکھوں خاندان تفریح کے لیے آتے ہیں۔ یہ تبدیلی راولپنڈی شہر کے لیے سب سے علامتی ارتقا تصور کی جاتی ہے۔','تاریخی'],
  ['قائدِ اعظم کا نام','پارک کا نام پاکستان کے بانی محمد علی جناح کے نام پر رکھا گیا۔ مرکزی دروازے پر قائدِ اعظم کا مجسمہ اور ان کے خاندانی نام سے متاثر ایک فن پارہ موجود ہے۔','تاریخی'],
  ['اتحاد کے نشان','پارک کے اندر چار بلند ستون کھڑے ہیں جنہیں یونٹی ٹاورز کہا جاتا ہے۔ یہ چاروں ستون پاکستان کے چاروں صوبوں کی نمائندگی کرتے ہیں اور ان کی اونچائی صوبے کے رقبے کے تناسب سے بنائی گئی ہے۔','ثقافتی'],
  ['روایتی سائبان','چاروں صوبوں کی روایتی پگڑیوں کی شکل میں چار چبوترے بنائے گئے ہیں جن میں چارپائیوں اور کشن کے ذریعے مقامی بیٹھک کا انداز اپنایا گیا ہے۔ یہ جگہ پارک کا ثقافتی گوشہ تصور ہوتی ہے۔','ثقافتی']
];

const facilities = [
  ['WC','عوامی بیت الخلا','پارک کے اندر متعدد مقامات پر عوامی بیت الخلا دستیاب ہیں؛ خاندانوں کے لیے صفائی اور دیکھ بھال پر خصوصی توجہ دی جاتی ہے۔'],
  ['P','پارکنگ','پارک کے اطراف بڑی پارکنگ موجود ہے جس میں ہزار سے زائد گاڑیوں کی گنجائش بتائی جاتی ہے؛ مصروف شاموں اور ویک اینڈ پر جلد جگہ منتخب کرنا بہتر ہے۔'],
  ['🍽','کھانے پینے کی اقسام','پارک کے اندر اور اطراف فاسٹ فوڈ، فیملی ریستوران، کافی شاپس اور آئس کریم کی دکانیں موجود ہیں۔'],
  ['🏨','رہائش','پارک کے قریب مختلف معیار کے ہوٹل اور گیسٹ ہاؤس دستیاب ہیں؛ انتخاب سے پہلے نقشے پر تازہ جائزے دیکھنا مفید ہے۔'],
  ['🛒','گروسری اور جنرل اسٹور','قریبی علاقوں میں گروسری اور جنرل اسٹور دستیاب ہیں؛ پارک کے اندر بھی چھوٹی دکانیں ملتی ہیں۔'],
  ['⛽','ایندھن اور چارجنگ','مرکزی سڑکوں پر پیٹرول پمپ موجود ہیں؛ الیکٹرک گاڑی کے لیے چارجنگ پوائنٹ کی دستیابی سفر سے پہلے نقشے پر تصدیق کر لیں۔']
];
---

<BaseLayout title={pageTitle} description={pageDescription} path="/">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(attractionSchema)}></script>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(englishFaqSchema)}></script>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)}></script>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>

  <header class="sticky top-0 z-50 border-b border-green-950/10 bg-[#fffdf8]/95 backdrop-blur">
    <div class="shell flex min-h-20 items-center justify-between gap-5">
      <a href="/" class="flex items-center" aria-label="جناح پارک راولپنڈی ہوم"><img src="/logo.svg" alt="جناح پارک راولپنڈی" class="h-14 w-auto" /></a>
      <nav class="hidden lg:flex items-center gap-4 text-sm font-bold text-green-950">
        <a href="#تعارف">تعارف</a><a href="#تاریخ">تاریخ</a><a href="#کہانیاں">کہانیاں</a><a href="#سہولیات">سہولیات</a><a href="#سفر">سفر</a><a href="#کھانا">کھانا</a><a href="#مقامات">مقامات</a><a href="#سوالات">سوالات</a>
      </nav>
      <a class="btn btn-primary text-sm" href="https://maps.app.goo.gl/dXD85cQCFkmbErrWA" target="_blank" rel="noopener noreferrer">نقشے میں کھولیں</a>
    </div>
  </header>

  <main>
    <section class="relative min-h-[650px] overflow-hidden bg-green-950 text-white">
      <img src="/images/jinnah-park-hero.jpg" alt="Jinnah Park Rawalpindi - Main view in Rawalpindi, Punjab, Pakistan" class="absolute inset-0 h-full w-full object-cover" />
      <div class="hero-overlay absolute inset-0"></div>
      <div class="shell relative z-10 flex min-h-[650px] items-end pb-16 pt-24 md:items-center md:pb-10">
        <div class="max-w-2xl rounded-[30px] border border-white/15 bg-green-950/35 p-7 shadow-2xl backdrop-blur-sm md:p-10">
          <p class="mb-4 text-sm font-bold text-green-100">راولپنڈی • چکلالہ کینٹ • پنجاب، پاکستان</p>
          <h1 class="text-5xl font-black leading-tight md:text-7xl">جناح پارک</h1>
          <p class="mt-2 text-2xl font-semibold text-green-100" dir="ltr">Jinnah Park, Rawalpindi</p>
          <p class="mt-6 max-w-xl text-lg leading-9 text-white/90">راولپنڈی کے معروف شہری تفریحی مقامات میں سے ایک، جہاں سبز میدان، واکنگ ایریاز، خاندانی سرگرمیاں، سینما اور کھانے کے اختیارات ایک ہی کمپلیکس کے آس پاس ملتے ہیں۔</p>
          <div class="mt-7 flex flex-wrap gap-3 text-sm">
            <span class="rounded-full bg-white/12 px-4 py-2">★ 4.5 · 28,750 جائزے</span>
            <span class="rounded-full bg-white/12 px-4 py-2">☎ +92 315 9734114</span>
            <span class="rounded-full bg-white/12 px-4 py-2">H3MC+MX6 · Rawalpindi</span>
          </div>
        </div>
      </div>
    </section>

    <nav class="border-b border-green-900/10 bg-[#fffdf8] py-3" aria-label="Breadcrumb">
      <ol class="shell flex flex-wrap items-center gap-2 text-sm text-slate-600">
        <li><a href="/" class="font-bold text-green-900 hover:underline">پاکستان</a></li>
        <li aria-hidden="true">›</li>
        <li><a href="/" class="font-bold text-green-900 hover:underline">پنجاب</a></li>
        <li aria-hidden="true">›</li>
        <li><a href="/" class="font-bold text-green-900 hover:underline">راولپنڈی</a></li>
        <li aria-hidden="true">›</li>
        <li class="font-black text-green-950" aria-current="page">جناح پارک</li>
      </ol>
    </nav>

    <section id="تعارف" class="shell py-16 md:py-24">
      <div class="grid gap-8 lg:grid-cols-[1.15fr_.85fr]">
        <article class="card p-7 md:p-10">
          <p class="eyebrow">شہر کے بیچ ایک سبز وقفہ</p>
          <h2 class="section-title mt-2">جناح پارک راولپنڈی کا تعارف</h2>
          <div class="prose-urdu mt-6 space-y-5 text-[1.05rem] text-slate-700">
