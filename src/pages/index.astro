---
import BaseLayout from '../layouts/BaseLayout.astro';
import Weather from '../components/Weather.astro';
import BidiText from '../components/BidiText.astro';
const title='جناح پارک راولپنڈی — مقام، داخلہ، Cinepax اور وزیٹر گائیڈ';
const description='Jinnah Park Rawalpindi کی اردو گائیڈ: درست مقام اور نقشہ، پارک اور Cinepax کے الگ اوقات و ٹکٹ، تاریخی تصاویر، موسم اور خاندان کے ساتھ سیر کی تیاری۔';
const origin=Astro.site?.origin ?? 'https://jinnahpark.com';
const maps='https://maps.app.goo.gl/dXD85cQCFkmbErrWA';
const cinema='https://web.cinepax.com/pages/cinemas.html';
const faq=[
 ['جناح پارک کہاں ہے؟','پتہ: Mushtaq Baig Shaheed Road، Chaklala Cantt.، راولپنڈی 46000، پنجاب، پاکستان۔ نقشے پر شہر اور مقام دونوں دیکھیں؛ اسلام آباد کا Fatima Jinnah Park ایک الگ مقام ہے۔'],
 ['کیا پارک کے اوقات اور Cinepax کے شوز ایک جیسے ہیں؟','23 اکتوبر 2026 کی Google Maps فہرست میں پارک کے اوقات روزانہ 06:00 سے اگلے دن 00:00، یعنی آدھی رات تک تھے، نہ کہ 24 گھنٹے۔ یہ تیسرے فریق کی اطلاع ہے؛ سینما، کھانا، آخری داخلہ اور دوسری سرگرمیاں الگ اوقات رکھ سکتی ہیں۔ موقع کی تازہ ہدایات کی تصدیق کریں۔'],
 ['داخلہ، پارکنگ اور سینما کی فیس کیا ہے؟','ان اخراجات کو الگ سمجھیں۔ پارک میں داخلے یا پارکنگ کی موجودہ فیس یہاں تصدیق شدہ نہیں؛ سینما کے ٹکٹ منتخب شو اور نشست کے مطابق آپریٹر سے دیکھیں۔ کوئی پرانا مفت داخلے کا دعویٰ یا سینما ٹکٹ پارک کے تمام اخراجات کا ثبوت نہیں۔'],
 ['Cinepax جناح پارک کا رابطہ کہاں ملے گا؟','Cinepax کی اپنی سرکاری ڈائریکٹری میں Jinnah Park، Kechari Road، Rawalpindi درج ہے۔ اسی ڈائریکٹری سے فون اور شوز دیکھیں؛ سینما کا فون پارک انتظامیہ کا عمومی رابطہ نہیں ہے۔'],
 ['کیا بچوں یا محدود نقل و حرکت والے افراد کے ساتھ جا سکتے ہیں؟','راستے، سیڑھیاں، قابل استعمال بیت الخلا، بیٹھنے کی جگہ اور موجودہ داخلی راستہ پہلے معلوم کریں۔ اس گائیڈ میں بلاسیڑھی رسائی، مخصوص پارکنگ یا ہر سہولت کی دستیابی کی تصدیق نہیں کی گئی۔'],
 ['کتنا وقت رکھیں؟','ابتدائی منصوبہ بندی کے لیے سیر اور وقفوں کا وقت رکھیں؛ اگر سینما کا شو شامل ہو تو اس کا دورانیہ، داخلے کی قطار اور واپسی کا وقت الگ شامل کریں۔ موسم اور اپنے ساتھیوں کی رفتار کے مطابق منصوبہ بدلیں۔']
];
const englishFaq=[
 ['Is this Jinnah Park in Rawalpindi?','Yes. This guide covers Jinnah Park, Rawalpindi, Punjab, Pakistan, rather than Fatima Jinnah Park in Islamabad. Check the linked place pin before travelling.'],
 ['Does a cinema ticket include park entry or parking?','Do not assume so. Confirm park admission and parking separately; Cinepax tickets concern a selected show and seat. Current park charges are not independently confirmed here. Maps listed daily 06:00 to 00:00 (the following midnight) on 23 October 2026; this is a dated third-party listing, not 24-hour opening or a guarantee for every service.'],
 ['How can I contact Cinepax Jinnah Park?','Use Cinepax’s own cinema directory for its Jinnah Park, Kechari Road, Rawalpindi listing. A cinema contact is not a verified general park-management number.']
];
const attraction={'@context':'https://schema.org','@type':['TouristAttraction','Park'],'@id':origin+'/#attraction',name:'Jinnah Park',alternateName:['جناح پارک','Jinnah Park Rawalpindi'],url:origin+'/',description,address:{'@type':'PostalAddress',streetAddress:'Mushtaq Baig Shaheed Road, Chaklala Cantt.',addressLocality:'Rawalpindi',postalCode:'46000',addressRegion:'Punjab',addressCountry:'PK'},geo:{'@type':'GeoCoordinates',latitude:33.5799287,longitude:73.0698898},hasMap:maps,image:[origin+'/images/jinnah-park-hero.jpg']};
const faqSchema={'@context':'https://schema.org','@type':'FAQPage',mainEntity:[...faq,...englishFaq].map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))};
const website={'@context':'https://schema.org','@type':'WebSite','@id':origin+'/#website',url:origin+'/',name:'جناح پارک راولپنڈی وزیٹر گائیڈ',inLanguage:'ur-PK'};
const breadcrumb={'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'جناح پارک راولپنڈی',item:origin+'/'}]};
const preparations=[['داخلہ اور اخراج','روانگی سے پہلے داخلی راستہ، آخری داخلہ اور کسی تقریب کی پابندیاں معلوم کریں۔ صرف نقشے پر راستہ دکھائی دینے سے ہر دروازے کا کھلا ہونا ثابت نہیں ہوتا۔'],['پارکنگ اور سفر','ڈرائیور سے مجاز اتارنے کی جگہ، واپسی کا انتظام اور مکمل کرایہ طے کریں۔ ہوائی اڈے یا اسلام آباد سے مقررہ سفر وقت یا مخصوص بس روٹ کی ضمانت نہیں دی جا رہی۔'],['بچوں کے ساتھ','ملاقات کی جگہ طے کریں، بچوں کو نظر میں رکھیں، پانی اور موسم کے مطابق وقفے رکھیں۔ کسی سرگرمی میں شامل ہونے سے پہلے عمر، قد اور حفاظتی ہدایات پوچھیں۔'],['رسائی اور سہولیات','وہیل چیئر، کم چلنے کی صلاحیت یا بچوں کی ضروریات ہوں تو راستے، بیت الخلا اور بیٹھنے کی جگہ پہلے معلوم کریں؛ پرانی تصویر کو موجودہ سہولت کی تصدیق نہ سمجھیں۔']];
---
<BaseLayout title={title} description={description} path="/">
{[attraction,faqSchema,website,breadcrumb].map(obj=><script is:inline type="application/ld+json" set:html={JSON.stringify(obj)}/>)}
<header class="sticky top-0 z-50 border-b border-green-950/10 bg-[#fffdf8]/95"><div class="shell flex flex-wrap items-center justify-between gap-4 py-4"><a href="/" aria-label="جناح پارک گائیڈ"><img src="/logo.svg" alt="جناح پارک راولپنڈی" class="h-14 w-auto"/></a><nav class="flex flex-wrap gap-4 text-sm font-bold" aria-label="اہم حصے"><a href="#مقام">مقام</a><a href="#داخلہ">داخلہ و اوقات</a><a href="#تاریخ">تاریخ</a><a href="#موسم">موسم</a><a href="#سوالات">سوالات</a></nav></div></header>
<section class="relative isolate min-h-[68vh] overflow-hidden bg-green-950 text-white"><img src="/images/jinnah-park-hero.jpg" alt="جناح پارک راولپنڈی کا داخلی دروازہ، 13 مارچ 2012 کی تصویر" class="absolute inset-0 -z-20 h-full w-full object-cover"/><div class="hero-overlay absolute inset-0 -z-10"></div><div class="shell py-24 md:py-32"><p class="font-bold text-green-100">راولپنڈی · پنجاب · پاکستان</p><h1 class="mt-5 max-w-3xl text-5xl font-black leading-relaxed md:text-7xl">جناح پارک راولپنڈی</h1><p class="prose-urdu mt-6 max-w-2xl text-lg">مقام تلاش کریں، پارک کی سیر اور سینما کا منصوبہ الگ رکھیں، اور روانگی سے پہلے داخلے، فیس اور سہولیات کی تصدیق کریں۔ یہ آزاد وزیٹر گائیڈ ہے، پارک انتظامیہ یا ٹکٹ فروش کی ویب سائٹ نہیں۔</p><div class="mt-8 flex flex-wrap gap-3"><a class="btn btn-primary" href="#داخلہ">سیر کی تیاری</a><a class="btn btn-map" href={maps}>نقشے میں مقام</a></div></div></section>
<div class="shell py-3 credit"><a href="https://commons.wikimedia.org/wiki/File:Jinnah_Park_Entrance.jpg">تصویر: Inlandmamba، 13 مارچ 2012</a> · <a href="https://commons.wikimedia.org/wiki/User:Verne_Equinox">Verne Equinox</a> نے 24 مئی 2020 کو روشن اور سیدھا کیا · <a href="https://creativecommons.org/licenses/by-sa/3.0/">CC BY-SA 3.0</a> · Commons کا موجودہ ترمیم شدہ نسخہ، نمائش میں کراپ ممکن؛ تاریخی منظر۔</div>
<main>
<section id="مقام" class="shell py-16"><p class="eyebrow">درست مقام</p><h2 class="section-title mt-2">راولپنڈی کے جناح پارک کو پہچانیں</h2><div class="mt-7 grid gap-8 lg:grid-cols-2"><div class="prose-urdu"><p>یہ گائیڈ راولپنڈی کے جناح پارک کے لیے ہے۔ دوسرے شہروں کے ہم نام پارک یا اسلام آباد کے Fatima Jinnah Park سے اسے الگ سمجھیں۔ نقشے کا مقام اور اپنی منزل کی تصدیق کے بعد سفر طے کریں۔</p><p class="mt-4">Cinepax کی موجودہ سرکاری ڈائریکٹری میں اس کی Jinnah Park شاخ کا پتہ <bdi dir="ltr">Jinnah Park, Kechari Road, Rawalpindi</bdi> ہے۔ یہ سینما کی فہرست ہے، پورے پارک کی تمام خدمات کی تصدیق نہیں۔</p><p class="mt-4">پتہ: <bdi dir="ltr">Mushtaq Baig Shaheed Road, Chaklala Cantt., Rawalpindi 46000</bdi>۔ نقشے کا مقام: <bdi dir="ltr">33.5799287, 73.0698898</bdi>۔</p><p class="mt-4">23 اکتوبر 2026 کی <a class="underline" href={maps}>Google Maps فہرست</a>: <bdi dir="ltr">4.5/5</bdi>، <bdi dir="ltr">28,795</bdi> جائزے۔ یہ تیسرے فریق کا اسی تاریخ کا خلاصہ ہے، اس گائیڈ کی اپنی درجہ بندی نہیں۔</p><a class="btn btn-soft mt-6" href={cinema}>Cinepax کی اپنی ڈائریکٹری</a></div><iframe class="min-h-[350px] w-full rounded-2xl border-0" src="https://www.google.com/maps?q=33.5799287,73.0698898&output=embed" title="راولپنڈی میں جناح پارک کا نقشہ" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe></div></section>
<section id="داخلہ" class="bg-green-50 py-16"><div class="shell"><p class="eyebrow">اوقات اور اخراجات</p><h2 class="section-title mt-2">پارک، سینما اور دوسری خدمات کو الگ رکھیں</h2><div class="mt-8 grid gap-5 md:grid-cols-3"><article class="card p-6 prose-urdu"><h3 class="font-black">پارک میں داخلہ</h3><p class="mt-3"><bdi dir="ltr">23</bdi> اکتوبر <bdi dir="ltr">2026</bdi> کو Google Maps کی فہرست میں ہر دن صبح <bdi dir="ltr">06:00</bdi> سے اگلے دن <bdi dir="ltr">00:00</bdi>، یعنی آدھی رات تک اوقات درج تھے۔ یہ <bdi dir="ltr">24</bdi> گھنٹے کھلا رہنے کا مطلب نہیں۔ یہ تیسرے فریق کی تاریخ وار اطلاع ہے، ہر سہولت یا داخلے کی ضمانت نہیں؛ داخلی دروازے یا انتظامیہ کی تازہ اطلاع دیکھیں۔</p></article><article class="card p-6 prose-urdu"><h3 class="font-black">Cinepax کے شوز</h3><p class="mt-3">شوز، نشستیں اور سینما کے ٹکٹ آپریٹر کی اپنی سائٹ سے منتخب کریں۔ سینما کے اوقات یا رابطے کو پارک کے عمومی اوقات یا نمبر کے طور پر استعمال نہ کریں۔</p><a class="underline" href={cinema}>سرکاری سینما ڈائریکٹری</a></article><article class="card p-6 prose-urdu"><h3 class="font-black">پارکنگ اور سرگرمیاں</h3><p class="mt-3">پارکنگ، کھانا اور دیگر سرگرمیاں الگ خرچ یا اوقات رکھ سکتی ہیں۔ خریداری سے پہلے مکمل قیمت اور شرائط پوچھیں؛ یہ گائیڈ ٹکٹ فروخت یا بکنگ کی تصدیق نہیں کرتی۔</p></article></div></div></section>
<section id="تاریخ" class="shell py-16"><div class="grid gap-8 md:grid-cols-2"><div class="prose-urdu"><p class="eyebrow">مقام کی یادداشت</p><h2 class="section-title mt-2">پارک اور پرانی جیل کا حوالہ</h2><p class="mt-5">Radio Pakistan کی 4 اپریل 2019 کی خبر نے راولپنڈی کے جناح پارک کو “Old Jail” کے ساتھ شناخت کیا اور وہاں ذوالفقار علی بھٹو کی برسی کی تقریب کا ذکر کیا۔ یہ تاریخی نسبت کا حوالہ ہے، آج کسی یادگار یا عمارت کے اندر جانے کی ضمانت نہیں۔</p><p class="mt-4">تاریخ میں دلچسپی ہو تو اصل خبر اور موقع پر نصب تشریح ساتھ پڑھیں۔ پرانے مقام کی شناخت کو کسی مخصوص عمارت کی موجودہ رسائی نہ سمجھیں؛ نئی سیر کے لیے داخلی ہدایات کو ترجیح دیں۔</p><a class="underline" href="https://www.radio.gov.pk/04-04-2019/40th-death-anniversary-of-zulfiqar-ali-bhutto-being-observed-today">Radio Pakistan کی اصل خبر</a></div><figure><img class="h-[360px] w-full rounded-2xl object-cover" src="/images/jinnah-park-fountain.jpg" loading="lazy" alt="جناح پارک راولپنڈی کا باغ اور بلند ستون، 13 مارچ 2012 کی تصویر"/><figcaption class="credit mt-3"><a href="https://commons.wikimedia.org/wiki/File:Jinnah_Park-1.jpg">تصویر: Inlandmamba، 13 مارچ 2012</a> · <a href="https://creativecommons.org/licenses/by-sa/3.0/">CC BY-SA 3.0</a> · اصل فائل، نمائش میں کراپ ممکن؛ آج کی حالت کا ثبوت نہیں۔</figcaption></figure></div></section>
<Weather/>
<section id="تیاری" class="shell py-16"><h2 class="section-title">خاندان کے ساتھ سیر کی تیاری</h2><div class="mt-8 grid gap-5 md:grid-cols-2">{preparations.map(([heading,body])=><article class="card p-6 prose-urdu"><h3 class="font-black">{heading}</h3><p class="mt-3"><BidiText text={body}/></p></article>)}</div><p class="prose-urdu mt-6">گرج چمک یا خراب موسم میں کھلے میدان اور درخت کے نیچے ٹھہرنے کے بجائے محفوظ عمارت کی طرف جائیں۔ پیش گوئی سے کسی سرگرمی کی انتظامی بندش ثابت نہیں ہوتی؛ موقع کی ہدایات دیکھیں۔</p></section>
<section id="سوالات" class="shell py-16"><h2 class="section-title">اکثر پوچھے جانے والے سوالات</h2><div class="mt-8 space-y-4">{faq.map(([q,a])=><details class="card p-6"><summary class="cursor-pointer font-black"><BidiText text={q}/></summary><p class="prose-urdu mt-4"><BidiText text={a}/></p></details>)}</div><section lang="en" dir="ltr" class="mt-10"><h3 class="text-xl font-bold">English visitor questions</h3><div class="mt-5 space-y-4">{englishFaq.map(([q,a])=><details class="card p-6"><summary class="cursor-pointer font-bold"><BidiText text={q}/></summary><p class="mt-4 leading-7"><BidiText text={a}/></p></details>)}</div></section></section>
<section class="shell py-12 prose-urdu"><h2 class="section-title">اصل ذرائع اور تصدیق</h2><p class="mt-4">ذرائع <bdi dir="ltr">23</bdi> اکتوبر <bdi dir="ltr">2026</bdi> کو دیکھے گئے۔ Cinema directory صرف متعلقہ آپریٹر کی معلومات ہے؛ تاریخی تصویر یا خبر موجودہ سہولیات یا اوقات کی تصدیق نہیں کرتی۔</p><ul class="mt-5 space-y-3"><li><a href={cinema}>Cinepax: اپنی شاخوں کی ڈائریکٹری</a></li><li><a href="https://www.radio.gov.pk/04-04-2019/40th-death-anniversary-of-zulfiqar-ali-bhutto-being-observed-today">Radio Pakistan: جناح پارک / Old Jail کا تاریخی حوالہ</a></li><li><a href="https://rawalpindi.punjab.gov.pk/important_places">ضلع راولپنڈی: شہر کے دوسرے اہم مقامات، الگ دورے کی منصوبہ بندی کے لیے</a></li><li><a href="/IMAGE-CREDITS.txt">ہر تصویر کا اصل ماخذ اور لائسنس</a></li></ul></section>
</main>
<footer class="bg-green-950 py-12 text-white"><div class="shell prose-urdu"><p>آزاد وزیٹر گائیڈ؛ پارک انتظامیہ، حکومت یا Cinepax کی آفیشل سائٹ نہیں۔</p><nav class="mt-5 flex flex-wrap gap-6"><a href="/privacy/">رازداری</a><a href="/cookies/">Cookie ترتیبات</a><a href="/terms/">شرائط</a><a href="/IMAGE-CREDITS.txt">تصویری ماخذ</a></nav></div></footer>
</BaseLayout>
