---
import BaseLayout from '../layouts/BaseLayout.astro';
const title='رازداری کی پالیسی — جناح پارک راولپنڈی وزیٹر گائیڈ';
const description='جناح پارک راولپنڈی وزیٹر گائیڈ کی رازداری کی پالیسی اور ذاتی ڈیٹا کے استعمال کی وضاحت۔';
---
<BaseLayout title={title} description={description} path="/privacy/">
  <main class="shell py-14 md:py-20"><a href="/" class="btn btn-soft">← مرکزی صفحہ</a><article class="card mt-6 p-7 md:p-12 prose-urdu"><p class="eyebrow">قانونی معلومات</p><h1 class="section-title mt-2">رازداری کی پالیسی</h1><p class="mt-3 text-slate-500">آخری اپ ڈیٹ: ستمبر 2026</p>
  <h2 class="mt-9 text-xl font-black text-green-950">ہم کون سی معلومات جمع کرتے ہیں</h2><p class="mt-3 text-slate-700">ہم صرف وہ کم سے کم ڈیٹا جمع کرنے کی کوشش کرتے ہیں جو ویب سائٹ چلانے، کارکردگی سمجھنے اور آپ کی درخواستوں کا جواب دینے کے لیے ضروری ہو۔ اس میں IP ایڈریس، براؤزر کی قسم، دیکھی گئی صفحات، Cookie یا اسی نوعیت کی ٹیکنالوجی، اور وہ معلومات شامل ہو سکتی ہیں جو آپ خود ای میل یا کسی رابطے کے ذریعے فراہم کریں۔</p>
  <h2 class="mt-9 text-xl font-black text-green-950">ہم معلومات کیسے استعمال کرتے ہیں</h2><p class="mt-3 text-slate-700">استعمال کے مقاصد میں مواد اور صارف تجربہ بہتر بنانا، مجموعی ٹریفک اور استعمال کے رجحانات سمجھنا، موصولہ درخواستوں کا جواب دینا اور قابل اطلاق قانونی ذمہ داریاں پوری کرنا شامل ہیں۔</p>
  <h2 class="mt-9 text-xl font-black text-green-950">تیسرے فریق کی خدمات</h2><p class="mt-3 text-slate-700">سائٹ Google Maps کو مقام دکھانے اور، صرف آپ کی analytics رضامندی کی صورت میں، Google Analytics 4 کو مجموعی استعمال سمجھنے کے لیے استعمال کر سکتی ہے۔ ان خدمات کی اپنی رازداری پالیسیاں اور شرائط ہیں۔</p>
  <h2 class="mt-9 text-xl font-black text-green-950">آپ کے حقوق</h2><p class="mt-3 text-slate-700">قابل اطلاق قوانین، جن میں GDPR جیسے ڈیٹا تحفظ کے فریم ورک شامل ہو سکتے ہیں، کے تحت آپ کو اپنے ذاتی ڈیٹا تک رسائی، درستگی، حذف کرنے کی درخواست، بعض پروسیسنگ پر اعتراض یا متعلقہ نگران ادارے سے شکایت کا حق حاصل ہو سکتا ہے۔</p>
  <h2 class="mt-9 text-xl font-black text-green-950">ڈیٹا کم سے کم رکھنے کا اصول</h2><p class="mt-3 text-slate-700">ہم غیر ضروری اکاؤنٹ، لاگ اِن یا پروفائل سسٹم استعمال نہیں کرتے۔ یہ ویب سائٹ بنیادی طور پر ایک جامد سیاحتی معلوماتی گائیڈ ہے۔</p></article></main>
</BaseLayout>
